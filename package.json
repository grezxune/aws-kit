    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-s3-control": "^3.1175.0",
    "@aws-sdk/client-sns": "^3.1175.0",
    "@aws-sdk/client-sts": "^3.1175.0",
    "@aws-sdk/credential-providers": "^3.1175.0",
